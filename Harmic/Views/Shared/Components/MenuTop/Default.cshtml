@model IEnumerable<Harmic.Models.TbMenu>

@foreach (var item in Model.Where(i => i.Levels == 1))
{
    var children = Model.Where(c => c.ParentId == item.MenuId).ToList();
    <li class="drop-holder">
        <a href="/@item.Alias">
            @item.Title
            @if (children.Any())
            {
                <i class="fa fa-chevron-down"></i>
            }
        </a>
        @if (children.Any())
        {
            <ul class="drop-menu">
                @foreach (var child in children)
                {
                    <li><a href="/@child.Alias">@child.Title</a></li>
                }
            </ul>
        }
    </li>
}
