{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Harmic (http://localhost:5245)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Harmic/bin/Debug/net10.0/Harmic.dll",
      "cwd": "${workspaceFolder}/Harmic",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5245"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\bNow listening on:\s+(https?://\S+)"
      }
    }
  ]
}
